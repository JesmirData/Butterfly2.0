import cv2
import mediapipe as mp
import numpy as np

# Dimensiones de la ventana del juego
ANCHO_VENTANA = 800
ALTO_VENTANA = 600

# Colores
COLOR_FONDO = (255, 255, 255)  # Blanco
COLOR_PIEZA = (50, 150, 250)  # Azul claro
COLOR_TEXTO = (0, 0, 0)      # Negro
COLOR_FELICITACION = (0, 255, 0) # Verde para el mensaje de felicitación

# Inicialización de MediaPipe Hands
mp_manos = mp.solutions.hands
manos = mp_manos.Hands(static_image_mode=False,
                      max_num_hands=1,
                      min_detection_confidence=0.7,
                      min_tracking_confidence=0.5)
mp_dibujo = mp.solutions.drawing_utils

# Función para dibujar una pieza enroscada (simplificada)
def dibujar_pieza(img, x, y, diametro, longitud_rosca, vueltas_restantes, angulo):
    """
    Dibuja una representación simplificada de una pieza enroscada.

    Args:
        img: La imagen de OpenCV en la que dibujar.
        x: Coordenada x del centro de la pieza.
        y: Coordenada y del centro de la pieza.
        diametro: Diámetro de la pieza.
        longitud_rosca: Longitud de la rosca (para calcular el número total de vueltas).
        vueltas_restantes: Número de vueltas restantes para desenroscar.
        angulo: Ángulo de rotación de la pieza.
    """
    # Dibujar el cuerpo de la pieza (un rectángulo para simplificar)
    largo_pieza = diametro * 3  # La longitud es proporcional al diámetro
    cv2.rectangle(img, (int(x - diametro / 2), int(y - diametro / 2)),
                  (int(x + diametro / 2), int(y + largo_pieza - diametro / 2)),
                  COLOR_PIEZA, -1)

    # Dibujar la rosca (líneas espirales simplificadas)
    num_lineas_rosca = 8  # Número de líneas de rosca
    espaciado_rosca = largo_pieza / num_lineas_rosca
    for i in range(num_lineas_rosca):
        y_actual = y + i * espaciado_rosca - diametro/2
        # Simular la rotación de la rosca con el ángulo
        x_inicio = int(x - diametro / 2 * np.cos(angulo + i * np.pi / 4))
        x_fin = int(x + diametro / 2 * np.cos(angulo + i * np.pi / 4))

        cv2.line(img, (x_inicio, int(y_actual)), (x_fin, int(y_actual)), (0,0,0), 2)

    # Dibujar la cabeza de la pieza (un círculo)
    cv2.circle(img, (int(x), int(y - diametro / 2)), int(diametro / 2), COLOR_PIEZA, -1)

    # Mostrar el contador de vueltas sobre la pieza
    cv2.putText(img, str(vueltas_restantes), (int(x - 20), int(y)),
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, COLOR_TEXTO, 2)



def calcular_vueltas(angulo_inicial, angulo_actual, total_vueltas):
    """
    Calcula el número de vueltas restantes basándose en el cambio de ángulo.

    Args:
        angulo_inicial: Ángulo inicial de la pieza.
        angulo_actual: Ángulo actual de la pieza.
        total_vueltas: Número total de vueltas para desenroscar.

    Returns:
        El número de vueltas restantes (entero).
    """
    # Normalizar la diferencia de ángulo al rango de 0 a 2*pi
    diff_angulo = (angulo_actual - angulo_inicial) % (2 * np.pi)
    if diff_angulo < 0:
        diff_angulo += 2 * np.pi
    vueltas_completadas = diff_angulo / (2 * np.pi)
    vueltas_restantes = int(max(0, total_vueltas - vueltas_completadas)) # Aseguramos que no sea negativo
    return vueltas_restantes

def detectar_movimiento_desenroscado(mano_landmarks, diametro_pieza):
    """
    Detecta el movimiento de desenroscado basado en los landmarks de la mano.

    Args:
        mano_landmarks: Los landmarks de la mano detectados por MediaPipe.
        diametro_pieza: El diametro de la pieza actual, para diferenciar entre
                        agarre de pinza y agarre de mano completa.

    Returns:
        True si se detecta un movimiento de desenroscado, False de lo contrario.
    """
    if mano_landmarks is None:
        return False

    # Obtener las coordenadas de algunos puntos clave de la mano
    pulgar = mano_landmarks.landmark[mp_manos.HandLandmark.THUMB_TIP]
    indice = mano_landmarks.landmark[mp_manos.HandLandmark.INDEX_FINGER_TIP]
    medio = mano_landmarks.landmark[mp_manos.HandLandmark.MIDDLE_FINGER_TIP]
    muneca = mano_landmarks.landmark[mp_manos.HandLandmark.WRIST]

    # Normalizar las coordenadas a las dimensiones de la imagen (0 a 1)
