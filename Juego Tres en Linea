import cv2
import numpy as np
import mediapipe as mp
import random
import time
import pygame

# Inicializar pygame para sonidos
pygame.mixer.init()
try:
    beep_sound = pygame.mixer.Sound('beep.wav')
    win_sound = pygame.mixer.Sound('win.wav')
    tie_sound = pygame.mixer.Sound('tie.wav')
except:
    beep_sound = pygame.mixer.Sound(buffer=np.zeros(1000))
    win_sound = pygame.mixer.Sound(buffer=np.zeros(1000))
    tie_sound = pygame.mixer.Sound(buffer=np.zeros(1000))

mp_hands = mp.solutions.hands
hands = mp_hands.Hands(max_num_hands=1, min_detection_confidence=0.7)
mp_draw = mp.solutions.drawing_utils

cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 800)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 800)

BOARD_SIZE = 600
MARGIN = 50
CELL_SIZE = BOARD_SIZE // 3
RESTART_DELAY = 3

COLORS = {
    'white': (255, 255, 255),
    'black': (0, 0, 0),
    'red': (0, 0, 255),
    'green': (0, 255, 0),
    'blue': (255, 0, 0),
    'dark_blue': (255, 100, 0),
    'bright_green': (0, 255, 100),
    'yellow': (0, 255, 255)
}

def reset_game():
    return {
        'board': [['' for _ in range(3)] for _ in range(3)],
        'player_symbol': 'X',
        'computer_symbol': 'O',
        'current_player': 'X',
        'game_over': False,
        'winner': None,
        'winning_line': None,
        'start_time': time.time(),
        'game_duration': 30,
        'last_move_time': time.time(),
        'game_over_time': None
    }

game_state = reset_game()

def draw_board(frame):
    board_img = np.ones((BOARD_SIZE, BOARD_SIZE, 3), dtype=np.uint8) * 255
    for i in range(1, 3):
        cv2.line(board_img, (i * CELL_SIZE, 0), (i * CELL_SIZE, BOARD_SIZE), COLORS['black'], 2)
        cv2.line(board_img, (0, i * CELL_SIZE), (BOARD_SIZE, i * CELL_SIZE), COLORS['black'], 2)

    for row in range(3):
        for col in range(3):
            cx = col * CELL_SIZE + CELL_SIZE // 2
            cy = row * CELL_SIZE + CELL_SIZE // 2
            if game_state['board'][row][col] == 'X':
                sz = CELL_SIZE // 3
                cv2.line(board_img, (cx - sz, cy - sz), (cx + sz, cy + sz), COLORS['dark_blue'], 5)
                cv2.line(board_img, (cx - sz, cy + sz), (cx + sz, cy - sz), COLORS['dark_blue'], 5)
            elif game_state['board'][row][col] == 'O':
                r = CELL_SIZE // 3
                cv2.circle(board_img, (cx, cy), r, COLORS['bright_green'], -1)
                cv2.circle(board_img, (cx, cy), r, COLORS['black'], 2)

    frame[MARGIN:MARGIN+BOARD_SIZE, MARGIN:MARGIN+BOARD_SIZE] = board_img

    if game_state['winning_line']:
        (sr, sc), (er, ec) = game_state['winning_line']
        sx = MARGIN + sc * CELL_SIZE + CELL_SIZE // 2
        sy = MARGIN + sr * CELL_SIZE + CELL_SIZE // 2
        ex = MARGIN + ec * CELL_SIZE + CELL_SIZE // 2
        ey = MARGIN + er * CELL_SIZE + CELL_SIZE // 2
        cv2.line(frame, (sx, sy), (ex, ey), COLORS['red'], 6)

    return frame

def check_winner(board):
    for i in range(3):
        if board[i][0] == board[i][1] == board[i][2] != '':
            return board[i][0], ((i, 0), (i, 2))
        if board[0][i] == board[1][i] == board[2][i] != '':
            return board[0][i], ((0, i), (2, i))
    if board[0][0] == board[1][1] == board[2][2] != '':
        return board[0][0], ((0, 0), (2, 2))
    if board[0][2] == board[1][1] == board[2][0] != '':
        return board[0][2], ((0, 2), (2, 0))
    return None, None

def find_winning_move(board, symbol):
    for r in range(3):
        for c in range(3):
            if board[r][c] == '':
                board[r][c] = symbol
                winner, _ = check_winner(board)
                board[r][c] = ''
                if winner == symbol:
                    return r, c
    return None

def computer_move():
    b = game_state['board']
    cs, ps = game_state['computer_symbol'], game_state['player_symbol']
    move = find_winning_move(b, cs) or find_winning_move(b, ps)
    if not move:
        empty = [(r, c) for r in range(3) for c in range(3) if b[r][c] == '']
        if not empty: return False
        move = random.choice(empty)
    r, c = move
    b[r][c] = cs
    beep_sound.play()
    return True

def get_finger_position(hand_landmarks, shape):
    idx = hand_landmarks.landmark[8]
    h, w = shape[:2]
    x, y = int(idx.x * w), int(idx.y * h)
    if MARGIN <= x < MARGIN+BOARD_SIZE and MARGIN <= y < MARGIN+BOARD_SIZE:
        return (y - MARGIN) // CELL_SIZE, (x - MARGIN) // CELL_SIZE
    return None, None

def draw_game_info(frame):
    elapsed = time.time() - game_state['start_time']
    remaining = max(0, game_state['game_duration'] - elapsed)
    cv2.putText(frame, f"Tiempo: {int(remaining)}s", (MARGIN, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, COLORS['black'], 2)

    if game_state['game_over']:
        msg = "¡Empate!" if game_state['winner'] == 'Tie' else f"¡{'Jugador' if game_state['winner']=='X' else 'Computadora'} gana!"
        color = COLORS['blue'] if game_state['winner'] == 'Tie' else COLORS['yellow']
        sz = cv2.getTextSize(msg, cv2.FONT_HERSHEY_SIMPLEX, 1.2, 3)[0]
        tx = (frame.shape[1] - sz[0]) // 2
        cv2.putText(frame, msg, (tx, MARGIN + BOARD_SIZE + 60), cv2.FONT_HERSHEY_SIMPLEX, 1.2, color, 3)

        if game_state['game_over_time']:
            rtime = max(0, RESTART_DELAY - (time.time() - game_state['game_over_time']))
            txt = f"Reiniciando en {int(rtime)}s"
            rsz = cv2.getTextSize(txt, cv2.FONT_HERSHEY_SIMPLEX, 0.8, 2)[0]
            rx = (frame.shape[1] - rsz[0]) // 2
            cv2.putText(frame, txt, (rx, MARGIN + BOARD_SIZE + 100), cv2.FONT_HERSHEY_SIMPLEX, 0.8, COLORS['black'], 2)
    else:
        ttext = f"Turno: {'Jugador (X)' if game_state['current_player']=='X' else 'Computadora (O)'}"
        cv2.putText(frame, ttext, (MARGIN + BOARD_SIZE - 300, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, COLORS['black'], 2)

    return frame

def check_game_over():
    game_state['winner'], game_state['winning_line'] = check_winner(game_state['board'])
    if game_state['winner']:
        game_state['game_over'] = True
        win_sound.play()
    elif all(c != '' for r in game_state['board'] for c in r):
        game_state['game_over'] = True
        game_state['winner'] = 'Tie'
        tie_sound.play()
    elif time.time() - game_state['start_time'] >= game_state['game_duration']:
        game_state['game_over'] = True
        game_state['winner'] = 'Tie'
        tie_sound.play()
    if game_state['game_over'] and game_state['game_over_time'] is None:
        game_state['game_over_time'] = time.time()

print("Tres en Raya con MediaPipe y Reinicio Automático")
while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        continue
    frame = cv2.flip(frame, 1)
    display = np.ones((MARGIN*2 + BOARD_SIZE, MARGIN*2 + BOARD_SIZE, 3), dtype=np.uint8) * 255
    frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(frame_rgb)
    display = draw_board(display)

    if game_state['game_over'] and game_state['game_over_time']:
        if time.time() - game_state['game_over_time'] >= RESTART_DELAY:
            game_state.update(reset_game())
    else:
        if not game_state['game_over']:
            if game_state['current_player'] == game_state['player_symbol'] and results.multi_hand_landmarks:
                for hand_landmarks in results.multi_hand_landmarks:
                    mp_draw.draw_landmarks(display, hand_landmarks, mp_hands.HAND_CONNECTIONS)
                    row, col = get_finger_position(hand_landmarks, display.shape)
                    if row is not None and col is not None and game_state['board'][row][col] == '':
                        x1 = MARGIN + col * CELL_SIZE
                        y1 = MARGIN + row * CELL_SIZE
                        cv2.rectangle(display, (x1, y1), (x1 + CELL_SIZE, y1 + CELL_SIZE), COLORS['green'], 2)
                        if time.time() - game_state['last_move_time'] > 2.0:
                            game_state['board'][row][col] = game_state['player_symbol']
                            beep_sound.play()
                            check_game_over()
                            if not game_state['game_over']:
                                game_state['current_player'] = game_state['computer_symbol']
                                game_state['last_move_time'] = time.time()
            elif game_state['current_player'] == game_state['computer_symbol']:
                if time.time() - game_state['last_move_time'] > 0.5:
                    if computer_move():
                        check_game_over()
                        if not game_state['game_over']:
                            game_state['current_player'] = game_state['player_symbol']
                        game_state['last_move_time'] = time.time()
                    else:
                        game_state['game_over'] = True
                        game_state['winner'] = 'Tie'
                        tie_sound.play()
                        game_state['game_over_time'] = time.time()

    display = draw_game_info(display)
    cv2.imshow('Tres en Raya - Reinicio Automático', display)
    key = cv2.waitKey(1)
    if key == 27 or key == ord('q'):
        break
    elif key == ord('r'):
        game_state.update(reset_game())

cap.release()
cv2.destroyAllWindows()
