import cv2
import mediapipe as mp
import numpy as np
import random
import time
from enum import Enum

# Configuración del juego
class Config:
    ANCHO_VENTANA = 1000
    ALTO_VENTANA = 700
    COLOR_FONDO = (240, 240, 240)
    COLOR_TEXTO = (50, 50, 50)
    FUENTE = cv2.FONT_HERSHEY_SIMPLEX
    DURACION_DESTELLO = 0.5  # segundos
    MAX_MARIPOSAS = 10

class NivelDificultad(Enum):
    BASICO = {"velocidad": 1, "tamanio": 50, "frecuencia": 3, "mariposas_simultaneas": 3}
    INTERMEDIO = {"velocidad": 1.5, "tamanio": 40, "frecuencia": 2, "mariposas_simultaneas": 6}
    AVANZADO = {"velocidad": 2, "tamanio": 30, "frecuencia": 1, "mariposas_simultaneas": 10}

class Mariposa:
    def __init__(self, ancho_ventana, alto_ventana, tamanio, velocidad):
        self.tamanio = tamanio
        self.velocidad = velocidad
        self.x = random.randint(tamanio, ancho_ventana - tamanio)
        self.y = random.randint(tamanio, alto_ventana - tamanio)
        self.direccion = random.uniform(0, 2 * np.pi)
        self.color = (
            random.randint(100, 255),
            random.randint(100, 255),
            random.randint(100, 255)
        )
        self.contador_animacion = 0
        self.velocidad_animacion = random.uniform(0.1, 0.3)
        self.activa = True
        self.tiempo_destello = 0
        self.destello_color = (0, 0, 0)
        self.angulo_alas = 0
        self.velocidad_alas = random.uniform(0.05, 0.15)

    def actualizar(self, ancho_ventana, alto_ventana):
        if not self.activa:
            return
        if random.random() < 0.02:
            self.direccion += random.uniform(-0.5, 0.5)
        self.x += np.cos(self.direccion) * self.velocidad
        self.y += np.sin(self.direccion) * self.velocidad
        if self.x < self.tamanio or self.x > ancho_ventana - self.tamanio:
            self.direccion = np.pi - self.direccion
        if self.y < self.tamanio or self.y > alto_ventana - self.tamanio:
            self.direccion = -self.direccion
        self.contador_animacion += self.velocidad_animacion
        self.angulo_alas = np.sin(self.contador_animacion) * np.pi/4

    def dibujar(self, img):
        if not self.activa:
            if time.time() - self.tiempo_destello < Config.DURACION_DESTELLO:
                cv2.circle(img, (int(self.x), int(self.y)), 
                          int(self.tamanio * 1.5), self.destello_color, -1)
            return
        cv2.ellipse(img, (int(self.x), int(self.y)), 
                   (int(self.tamanio/5), int(self.tamanio/3)), 
                   0, 0, 360, (50, 50, 50), -1)
        for signo in [-1, 1]:
            pts_superior = []
            for i in range(5):
                ang = self.angulo_alas * signo + i * np.pi/8
                pts_superior.append((
                    int(self.x + np.cos(ang) * self.tamanio * 0.8),
                    int(self.y + np.sin(ang) * self.tamanio * 0.6 * signo)
                ))
            cv2.fillPoly(img, [np.array(pts_superior)], self.color)
            pts_inferior = []
            for i in range(5):
                ang = -self.angulo_alas * signo + i * np.pi/8 + np.pi/2
                pts_inferior.append((
                    int(self.x + np.cos(ang) * self.tamanio * 0.6),
                    int(self.y + np.sin(ang) * self.tamanio * 0.8 * signo)
                ))
            cv2.fillPoly(img, [np.array(pts_inferior)], self.color)
        cv2.circle(img, (int(self.x + self.tamanio*0.3), int(self.y)), 
                  int(self.tamanio/6), (255, 255, 255), -1)
        cv2.circle(img, (int(self.x - self.tamanio*0.3), int(self.y)), 
                  int(self.tamanio/6), (255, 255, 255), -1)

    def verificar_agarre(self, distancia_pulgar_indice, centro_pinza):
        if not self.activa:
            return False
        distancia = np.sqrt((self.x - centro_pinza[0])**2 + (self.y - centro_pinza[1])**2)
        if distancia < self.tamanio and distancia_pulgar_indice < self.tamanio:
            self.activa = False
            self.tiempo_destello = time.time()
            self.destello_color = (
                random.randint(200, 255),
                random.randint(200, 255),
                random.randint(200, 255)
            )
            return True
        return False

class JuegoMariposas:
    def __init__(self):
        self.cap = cv2.VideoCapture(0)
        self.mp_manos = mp.solutions.hands
        self.manos = self.mp_manos.Hands(False, 1, 0.7, 0.5)
        self.mp_dibujo = mp.solutions.drawing_utils
        self.nivel_actual = NivelDificultad.BASICO
        self.puntuacion = 0
        self.mariposas = []
        self.ultima_mariposa_creada = 0
        self.mariposas_atrapadas = 0
        self.tiempo_inicio_nivel = time.time()
        self.duracion_nivel = 60
        self.juego_activo = True
        self.mensaje = ""
        self.tiempo_mensaje = 0

        # Botones
        self.boton_inicio = {"x": 800, "y": 20, "w": 160, "h": 60}
        self.boton_salir = {"x": 800, "y": 100, "w": 160, "h": 60}
        self.tiempo_dedo_sobre_salir = None

    def iniciar_nivel(self, nivel):
        self.nivel_actual = nivel
        self.mariposas = []
        self.mariposas_atrapadas = 0
        self.tiempo_inicio_nivel = time.time()
        self.ultima_mariposa_creada = time.time()
        self.juego_activo = True
        self.mensaje = f"Nivel {nivel.name.capitalize()} - Atrapa las mariposas!"
        self.tiempo_mensaje = time.time()

    def crear_mariposas(self):
        config = self.nivel_actual.value
        tiempo_actual = time.time()
        if (tiempo_actual - self.ultima_mariposa_creada > config["frecuencia"] and
            len([m for m in self.mariposas if m.activa]) < config["mariposas_simultaneas"] and
            len(self.mariposas) < Config.MAX_MARIPOSAS):
            self.mariposas.append(Mariposa(Config.ANCHO_VENTANA, Config.ALTO_VENTANA,
                                           config["tamanio"], config["velocidad"]))
            self.ultima_mariposa_creada = tiempo_actual

    def actualizar_mariposas(self):
        for mariposa in self.mariposas:
            mariposa.actualizar(Config.ANCHO_VENTANA, Config.ALTO_VENTANA)
        self.mariposas = [
            m for m in self.mariposas 
            if m.activa or (time.time() - m.tiempo_destello < Config.DURACION_DESTELLO)
        ]

    def dibujar_mariposas(self, img):
        for mariposa in self.mariposas:
            mariposa.dibujar(img)

    def detectar_pinza(self, landmarks, frame_shape):
        if not landmarks:
            return 0, (0, 0)
        pulgar = landmarks.landmark[self.mp_manos.HandLandmark.THUMB_TIP]
        indice = landmarks.landmark[self.mp_manos.HandLandmark.INDEX_FINGER_TIP]
        h, w = frame_shape[:2]
        pulgar_x, pulgar_y = int(pulgar.x * w), int(pulgar.y * h)
        indice_x, indice_y = int(indice.x * w), int(indice.y * h)
        distancia = np.sqrt((pulgar_x - indice_x)**2 + (pulgar_y - indice_y)**2)
        centro = ((pulgar_x + indice_x)//2, (pulgar_y + indice_y)//2)
        return distancia, centro

    def verificar_colisiones(self, distancia_pinza, centro_pinza):
        if distancia_pinza == 0:
            return
        for mariposa in self.mariposas:
            if mariposa.verificar_agarre(distancia_pinza, centro_pinza):
                self.mariposas_atrapadas += 1
                self.puntuacion += 10 * (self.nivel_actual.value["mariposas_simultaneas"] / 3)

    def mostrar_info_juego(self, img):
        tiempo_restante = max(0, self.duracion_nivel - (time.time() - self.tiempo_inicio_nivel))
        cv2.putText(img, f"Puntuación: {self.puntuacion}", (20, 40), Config.FUENTE, 0.8, Config.COLOR_TEXTO, 2)
        cv2.putText(img, f"Tiempo: {int(tiempo_restante)}s", (20, 80), Config.FUENTE, 0.8, Config.COLOR_TEXTO, 2)
        cv2.putText(img, f"Mariposas: {self.mariposas_atrapadas}", (20, 120), Config.FUENTE, 0.8, Config.COLOR_TEXTO, 2)
        cv2.putText(img, f"Nivel: {self.nivel_actual.name.capitalize()}", (20, 160), Config.FUENTE, 0.8, Config.COLOR_TEXTO, 2)
        if time.time() - self.tiempo_mensaje < 3:
            texto_size = cv2.getTextSize(self.mensaje, Config.FUENTE, 0.8, 2)[0]
            texto_x = (Config.ANCHO_VENTANA - texto_size[0]) // 2
            cv2.putText(img, self.mensaje, (texto_x, 40), Config.FUENTE, 0.8, Config.COLOR_TEXTO, 2)

    def dibujar_botones(self, img):
        cv2.rectangle(img, (self.boton_inicio["x"], self.boton_inicio["y"]),
                      (self.boton_inicio["x"] + self.boton_inicio["w"], self.boton_inicio["y"] + self.boton_inicio["h"]),
                      (0, 200, 0), -1)
        cv2.putText(img, "Iniciar", (self.boton_inicio["x"] + 10, self.boton_inicio["y"] + 40),
                    Config.FUENTE, 0.8, (255, 255, 255), 2)
        cv2.rectangle(img, (self.boton_salir["x"], self.boton_salir["y"]),
                      (self.boton_salir["x"] + self.boton_salir["w"], self.boton_salir["y"] + self.boton_salir["h"]),
                      (0, 0, 200), -1)
        cv2.putText(img, "Salir", (self.boton_salir["x"] + 30, self.boton_salir["y"] + 40),
                    Config.FUENTE, 0.8, (255, 255, 255), 2)

    def verificar_boton_salir(self, centro_dedo):
        x, y = centro_dedo
        bx, by, bw, bh = self.boton_salir.values()
        if bx <= x <= bx + bw and by <= y <= by + bh:
            if self.tiempo_dedo_sobre_salir is None:
                self.tiempo_dedo_sobre_salir = time.time()
            elif time.time() - self.tiempo_dedo_sobre_salir > 1:
                return True
        else:
            self.tiempo_dedo_sobre_salir = None
        return False

    def verificar_fin_nivel(self):
        tiempo_transcurrido = time.time() - self.tiempo_inicio_nivel
        if tiempo_transcurrido > self.duracion_nivel:
            self.juego_activo = False
            if self.nivel_actual == NivelDificultad.BASICO:
                self.mensaje = "¡Nivel Básico completado! Pasando a Intermedio..."
                self.iniciar_nivel(NivelDificultad.INTERMEDIO)
            elif self.nivel_actual == NivelDificultad.INTERMEDIO:
                self.mensaje = "¡Nivel Intermedio completado! Pasando a Avanzado..."
                self.iniciar_nivel(NivelDificultad.AVANZADO)
            else:
                self.mensaje = "¡Juego completado! Good Job!"
            self.tiempo_mensaje = time.time()
            return True
        return False

    def ejecutar(self):
        self.iniciar_nivel(NivelDificultad.BASICO)
        while True:
            ret, frame = self.cap.read()
            if not ret:
                break
            frame = cv2.flip(frame, 1)
            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            frame = cv2.resize(frame, (Config.ANCHO_VENTANA, Config.ALTO_VENTANA))
            img_juego = np.full((Config.ALTO_VENTANA, Config.ANCHO_VENTANA, 3), Config.COLOR_FONDO, dtype=np.uint8)
            resultados = self.manos.process(frame_rgb)

            if self.juego_activo:
                self.crear_mariposas()
                self.actualizar_mariposas()
                self.dibujar_mariposas(img_juego)
                distancia_pinza, centro_pinza = 0, (0, 0)
                if resultados.multi_hand_landmarks:
                    for mano_landmarks in resultados.multi_hand_landmarks:
                        self.mp_dibujo.draw_landmarks(img_juego, mano_landmarks, self.mp_manos.HAND_CONNECTIONS)
                        distancia_pinza, centro_pinza = self.detectar_pinza(mano_landmarks, img_juego.shape)
                        if self.verificar_boton_salir(centro_pinza):
                            self.cap.release()
                            cv2.destroyAllWindows()
                            return
                self.verificar_colisiones(distancia_pinza, centro_pinza)
                self.mostrar_info_juego(img_juego)
                self.verificar_fin_nivel()
            self.dibujar_botones(img_juego)
            if not self.juego_activo and time.time() - self.tiempo_mensaje < 5:
                texto_size = cv2.getTextSize(self.mensaje, Config.FUENTE, 1, 2)[0]
                texto_x = (Config.ANCHO_VENTANA - texto_size[0]) // 2
                texto_y = (Config.ALTO_VENTANA + texto_size[1]) // 2
                cv2.putText(img_juego, self.mensaje, (texto_x, texto_y), Config.FUENTE, 1, (0, 100, 200), 2)
            cv2.imshow("Terapia Visual con Mariposas", img_juego)
            key = cv2.waitKey(1)
            if key == ord('q'):
                break
            elif key == ord('r') or key == ord('i'):
                self.iniciar_nivel(NivelDificultad.BASICO)
                self.puntuacion = 0

        self.cap.release()
        cv2.destroyAllWindows()

if __name__ == "__main__":
    juego = JuegoMariposas()
    juego.ejecutar()
